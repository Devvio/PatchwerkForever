<Bindings>
	<!-- Each body asks first whether its function is there: with a base too old for this addon the
	     files after Link.lua do nothing, and a bound key would otherwise give a Lua error. -->
	<Binding name="PATCHWERKFOREVER_THREAD_GO" header="PATCHWERKFOREVER_THREAD" category="BINDING_CATEGORY_PatchwerkForever">
		if PatchwerkForever_Thread_Routes_Go then PatchwerkForever_Thread_Routes_Go() end
	</Binding>
	<Binding name="PATCHWERKFOREVER_THREAD_STOP" category="BINDING_CATEGORY_PatchwerkForever">
