# Copy this file to .env (beside it) and fill it in. This copy is kept in git: put no token in it.
#
# Settings for the tools in tools/, on this machine only.
# Git ignores this file (.gitignore), so what is put here is never committed or uploaded.
#
# CF_API_TOKEN   Your CurseForge API token: CurseForge author settings, API Tokens.
#                tools/upload.py reads it from here to add files to your projects. It is a password:
#                put it after the = below, with no spaces or quotes, and show this file to no one.
#                An environment variable of the same name wins over this line (CI uses a secret).
CF_API_TOKEN=
